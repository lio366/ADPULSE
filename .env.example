# ADPULSE SaaS provider configuration
# Copy this file to .env and replace the placeholders with real credentials.
# Credentials alone do not enable integrations; provider adapters and health checks are required.

ECO_IA_SERVICE_URL=http://127.0.0.1:8001
DATABASE_URL=mysql://adpulse_user:replace-with-url-safe-password@127.0.0.1:3306/adpulse

CRM_API_KEY=replace-with-real-crm-key
CRM_BASE_URL=https://your-crm.example.com
CRM_WEBHOOK_URL=https://your-webhook.example.com

ADS_API_KEY=replace-with-real-ads-key
META_ADS_TOKEN=replace-with-real-meta-token
ADS_ACCOUNT_ID=replace-with-real-account-id

ERP_API_URL=https://erp.example.com/api
ERP_API_KEY=replace-with-real-erp-key
ERP_CLIENT_ID=replace-with-real-client-id

BILLING_API_KEY=replace-with-real-billing-key
STRIPE_SECRET_KEY=replace-with-real-stripe-secret
BILLING_API_URL=https://billing.example.com/api

NOTIFY_API_KEY=replace-with-real-notification-key
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/THIS/WEBHOOK
RESEND_API_KEY=replace-with-real-resend-key

REQUIRE_AGENT_QUEUE_AUTH=true
ADPULSE_AUTH_JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
NODE_ENV=development
